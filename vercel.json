{
  "framework": null,
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/content/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "functions": {
    "api/weekly-notes.js": {
      "includeFiles": "server/weekly-notes.json"
    },
    "api/updates.js": {
      "includeFiles": "server/*.json"
    }
  }
}